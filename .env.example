# Optional overrides (defaults are in app/config.py)
# HTTP_TIMEOUT_SECONDS=10

# Google Pollen API (optional US/global fallback when Open-Meteo pollen is missing)
# Enable pollen.googleapis.com in Google Cloud and create an API key.
# Base64 is encoding only — not encryption. Restrict the key in GCP; never commit .env

# Encode your key once:
# python3 -c "import base64; print(base64.b64encode(b'YOUR_KEY_HERE').decode())"
# GOOGLE_POLLEN_API_KEY_B64=paste_output_here

# Or plain text (fallback if B64 is unset):
# GOOGLE_POLLEN_API_KEY=your_key_here
